@model Species

@{
    Layout = "_LayoutCustom";

}


<body class="container">


    <div>
        <h1 class="text-white" >@Model.Name</h1>
        <h3 class="text-white" >@Model.Kind.Name</h3>
        <h3 class="text-white" >@Model.Kind.Color</h3>
        <h3 class="text-white" >@Model.CreatedDate.ToShortDateString()</h3>
    </div>

</body>

